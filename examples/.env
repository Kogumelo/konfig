# Example environment variables (.env)
# Every value is text; ${VAR} is not expanded.

# Name shown at the top
APP_TITLE="Kogumelo Dashboard"
APP_VERSION=3

# Server address and port
export SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# debug | info | warning | error
LOG_LEVEL=info

# firebird | postgres
DATABASE_DRIVER=firebird
DATABASE_POOL=12  # simultaneous connections
DATABASE_URL='firebird://localhost:3050/data.fdb'
DATABASE_PASSWORD="change#this password"

# path with a variable (stays as text)
BACKUP_DESTINATION=${HOME}/backup
