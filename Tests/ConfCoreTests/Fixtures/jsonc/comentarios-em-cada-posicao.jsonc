// antes da raiz
/* bloco antes da raiz */
{ // depois do {
  // acima da chave
  "a": 1, // fim da linha, depois da vírgula
  "b" /* entre chave e dois-pontos */ : /* entre dois-pontos e valor */ 2,
  "c": 3 /* depois do valor, antes da vírgula */,
  /* bloco
   * de várias
   * linhas */
  "d": "x",
  "e": [ // depois do [
    1, // item
    /* antes do item */ 2,
    3 // último item, sem vírgula
  ],
  "f": { /* objeto só com comentário */ },
  "g": [ /* lista só com comentário */ ],
  "h": {
    // aninhado
    "i": true /* fim */
  }
  // antes do }
} // depois da raiz
/* bloco no fim do arquivo */
