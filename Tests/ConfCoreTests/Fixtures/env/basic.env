# Example file with the basic rules

# App name
APP_NAME=Konfig
export APP_PORT=8080
  INDENTED=yes
SPACES_AROUND_EQUALS = value with spaces   
EMPTY=
EMPTY_WITH_COMMENT=   # nothing yet
WITH_COMMENT=abc # comment at the end
ATTACHED_HASH=abc#def
# log level
# debug | info | warning | error
LOG_LEVEL=info
mode.dot-and-dash_1=ok
export=variable named export
URL=postgres://u:p@localhost:5432/db?ssl=true&x=1
EQUALS_IN_VALUE=a=b=c
APOSTROPHE_IN_MIDDLE=it's
