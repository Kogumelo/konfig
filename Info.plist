<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Konfig</string>
	<key>CFBundleDisplayName</key>
	<string>Konfig</string>
	<key>CFBundleIdentifier</key>
	<string>br.com.kogut.konfig</string>
	<key>CFBundleExecutable</key>
	<string>Konfig</string>
	<key>CFBundleIconFile</key>
	<string>Konfig</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pt-BR</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Kogumelo Informática Ltda. MIT License. Test cases from toml-test, JSONTestSuite, json5-tests and yaml-test-suite under the MIT License.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>TOML Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.toml</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Document</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JSON Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>br.com.kogut.konfig.jsonc</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Document</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JSON5 Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>br.com.kogut.konfig.json5</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Document</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Environment Variables (.env)</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>br.com.kogut.konfig.env</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Document</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>INI Configuration</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>br.com.kogut.konfig.ini</string>
				<!-- type Xcode declares for .ini; when Xcode is installed, it is the one the system uses -->
				<string>com.microsoft.ini</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Document</string>
		</dict>
		<dict>
			<!-- public.yaml is declared by macOS itself (extensions yaml and yml, conforming to
			     public.text): no imported declaration needed. -->
			<key>CFBundleTypeName</key>
			<string>YAML Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.yaml</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Document</string>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.toml</string>
			<key>UTTypeDescription</key>
			<string>TOML Document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>toml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/toml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- macOS does not declare JSONC (the .jsonc extension gets a "dynamic" type).
			     Imported declaration: if another app declares the type, its declaration wins.
			     Conforms to public.plain-text, not public.json: that way Spotlight indexes the
			     content (RichText importer; public.json has no importer) and "Open With"
			     offers the text editors. It also keeps programs that only read strict JSON
			     from offering to open it. Tested on macOS 26 (see README). -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.konfig.jsonc</string>
			<key>UTTypeDescription</key>
			<string>JSON with Comments (JSONC)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>jsonc</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- JSON5 (spec.json5.org): same reasoning as JSONC. -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.konfig.json5</string>
			<key>UTTypeDescription</key>
			<string>JSON5</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>json5</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/json5</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- macOS does not declare .env. The extension only covers "production.env"; ".env" (no
			     extension as far as the system is concerned) and ".env.local" are recognized by name, in the app. -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.konfig.env</string>
			<key>UTTypeDescription</key>
			<string>Environment Variables (.env)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>env</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- macOS does not declare .ini (the extension gets a "dynamic" type). Same
			     reasoning as JSONC: conforms to public.plain-text. ".editorconfig" (no
			     extension as far as the system is concerned) is recognized by name, in the app. -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.konfig.ini</string>
			<key>UTTypeDescription</key>
			<string>INI Configuration</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ini</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
