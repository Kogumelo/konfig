<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>km-conf</string>
	<key>CFBundleDisplayName</key>
	<string>km-conf</string>
	<key>CFBundleIdentifier</key>
	<string>br.com.kogut.km-conf</string>
	<key>CFBundleExecutable</key>
	<string>km-conf</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt-BR</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Ferramenta pessoal km-*. Casos de teste do toml-test, da JSONTestSuite e do json5-tests sob licença MIT.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Documento TOML</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.toml</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Documento</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Documento JSON</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>br.com.kogut.km-conf.jsonc</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Documento</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Documento JSON5</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>br.com.kogut.km-conf.json5</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Documento</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Variáveis de ambiente (.env)</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>br.com.kogut.km-conf.env</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Documento</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Configuração INI</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>br.com.kogut.km-conf.ini</string>
				<!-- tipo que o Xcode declara para .ini; quando o Xcode está instalado, é o que o sistema usa -->
				<string>com.microsoft.ini</string>
			</array>
			<key>NSDocumentClass</key>
			<string>Documento</string>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.toml</string>
			<key>UTTypeDescription</key>
			<string>Documento TOML</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>toml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/toml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- O macOS não declara JSONC (a extensão .jsonc fica com um tipo "dinâmico").
			     Declaração importada: se outro app declarar o tipo, a dele vale.
			     Derivado de public.plain-text, e não de public.json: assim o Spotlight indexa o
			     conteúdo (importador RichText; public.json fica sem importador) e o "Abrir com"
			     oferece os editores de texto. Também evita que programas que só leem JSON
			     estrito se ofereçam para abrir. Testado no macOS 26 (ver README). -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.km-conf.jsonc</string>
			<key>UTTypeDescription</key>
			<string>JSON com comentários (JSONC)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>jsonc</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- JSON5 (spec.json5.org): mesmo raciocínio do JSONC. -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.km-conf.json5</string>
			<key>UTTypeDescription</key>
			<string>JSON5</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>json5</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/json5</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- O macOS não declara .env. A extensão só cobre "producao.env"; ".env" (sem
			     extensão para o sistema) e ".env.local" são reconhecidos pelo nome, no app. -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.km-conf.env</string>
			<key>UTTypeDescription</key>
			<string>Variáveis de ambiente (.env)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>env</string>
				</array>
			</dict>
		</dict>
		<dict>
			<!-- O macOS não declara .ini (a extensão fica com um tipo "dinâmico"). Mesmo
			     raciocínio do JSONC: derivado de public.plain-text. O ".editorconfig" (sem
			     extensão para o sistema) é reconhecido pelo nome, no app. -->
			<key>UTTypeIdentifier</key>
			<string>br.com.kogut.km-conf.ini</string>
			<key>UTTypeDescription</key>
			<string>Configuração INI</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ini</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
