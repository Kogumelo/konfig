// Configuração de exemplo em JSON5 (https://spec.json5.org)
{
  titulo: 'Painel Kogumelo', // Nome que aparece no topo
  versao: 3,
  descricao: 'Painel dos sistemas \
Kogumelo e LanceWeb',

  servidor: {
    host: '0.0.0.0',
    portas: [8080, 8443],
    tls: true, // exige certificado
    // debug | info | aviso | erro
    nivel_log: 'info',
    permissoes: 0x1ED, // 0755 em octal
    tempo_limite: .5, // segundos
  },

  banco: {
    /* firebird | postgres */
    driver: "firebird",
    pool: 12, // conexões simultâneas
    fator: +1.50,
    limite_linhas: Infinity,
    caminho: 'C:\\dados\\banco.fdb',
    senha_arquivo: null,
  },

  tarefas: [
    {
      nome: 'backup',
      // minuto hora dia mês dia-da-semana
      cron: '0 3 * * *',
      ativo: true,
      ambiente: { DESTINO: '/mnt/backup', 'NIVEL-COMPRESSAO': 6 },
    },
    {
      nome: 'limpar-logs',
      // minuto hora dia mês dia-da-semana
      cron: '0 4 * * 0',
      ativo: false,
    },
  ],
}
