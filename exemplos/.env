# Variáveis de ambiente de exemplo (.env)
# Todo valor é texto; ${VAR} não é expandido.

# Nome que aparece no topo
APP_TITULO="Painel Kogumelo"
APP_VERSAO=3

# Endereço e porta do servidor
export SERVIDOR_HOST=0.0.0.0
SERVIDOR_PORTA=8080
# debug | info | aviso | erro
NIVEL_LOG=info

# firebird | postgres
BANCO_DRIVER=firebird
BANCO_POOL=12  # conexões simultâneas
BANCO_URL='firebird://localhost:3050/dados.fdb'
BANCO_SENHA="troque#esta senha"

# caminho com variável (fica como texto)
BACKUP_DESTINO=${HOME}/backup
